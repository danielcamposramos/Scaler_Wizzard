   "source": [
    "# 🧙‍♂️ Scaler Wizard: TRMC Linear Training Cockpit\n",
    "This notebook orchestrates the high-fidelity training of the Tiny Recursive MoE Contrastive model using real-world datasets (Wikipedia, Math, Games) and Unsloth acceleration."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 1. Environment Readiness Check\n",
    "import sys\n",
    "import os\n",
    "sys.path.append(os.path.abspath('..'))\n",
    "\n",
    "from tools.verify_debian import verify_debian_readiness\n",
    "verify_debian_readiness()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from components.scaling_engine.unsloth_engine import UnslothEngine\n",
    "from components.scaling.profile_recommender import ProfileRecommender\n",
    "from components.scaling.dataset_curator import DatasetCurator\n",
    "\n",
    "# Initialize the Wizard's components\n",
    "recommender = ProfileRecommender()\n",
    "curator = DatasetCurator(cache_dir=\"../checkpoints/datasets\")\n",
    "\n",
    "# Get hardware-aware recommendations for the 'trmc_special' Vibe\n",
    "profile = recommender.recommend_profile(use_case=\"trmc_special\", model_size=\"small\")\n",
    "\n",
    "print(f\"🚀 Vibe set to: TRMC Special Mixture\")\n",
    "print(f\"📈 Target Epochs: {profile.get('epochs')}\")\n",
    "print(f\"🧠 Model Speed: {'Unsloth Turbo' if profile.get('use_unsloth') else 'Standard'}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 2. Initialize the Unsloth Speed Engine\n",
    "# We'll use TinyLlama as our base for its excellent 128k context and Apache license\n",
    "model_name = \"TinyLlama/TinyLlama-1.1B-Chat-v1.0\"\n",
    "engine = UnslothEngine(model_name=model_name, max_seq_length=4096)\n",
    "engine.apply_fast_lora(r=profile.get(\"lora_rank\", 16))\n",
    "\n",
    "print(f\"✅ Model {model_name} loaded and patched with Fast LoRA.\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 3. Execute Linear Training Run (5 Epochs Mixture)\n",
    "# This pulls Wikipedia, NuminaMath, Chess PGN, and ORPO data into one stream\n",
    "training_args = {\n",
    "    \"epochs\": profile.get(\"epochs\", 5),\n",
    "    \"batch_size\": 2,\n",
    "    \"learning_rate\": 5e-6,\n",
    "    \"beta\": profile.get(\"orpo_beta\", 0.1),\n",
    "    \"output_dir\": \"../outputs/trmc_final_run\"\n",
    "}\n",
    "\n",
    "print(\"🔥 Starting linear training process across all datasets...\")\n",
    "engine.run_orpo_alignment(\n",
    "    dataset_configs=profile.get(\"recommended_datasets\", []),\n",
    "    args_dict=training_args\n",
    ")"
   ]
  }\n",
 ],
